# macOS
.DS_Store
*.swp

# Logs
*.log
firebase-debug.log
firestore-debug.log

# Editor / local Claude state
.claude/settings.local.json
.claude/worktrees/

# Node (if tooling is added later)
node_modules/
npm-debug.log*

# Env / secrets
.env
.env.*
*.pem
*.p8

# Mobile signing material. This plugin has no app code of its own, so none of these can appear
# here — they are listed because this file is the reference a generated project's .gitignore is
# seeded from, and a mobile studio's ignore list that omits keystores is a leak waiting for its
# first real project. Cheaper to carry the lines than to find out which one was missing.
*.jks
*.keystore
keystore.properties
*.p12
*.cer
*.mobileprovision
google-services.json
GoogleService-Info.plist
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Per-agent git worktrees (agent-isolation skill)
.agent-wt/

# App Store Connect API key
*.p8

# Local dry-run fixture apps (hundreds of MB of scratch builds, never shipped)
/dry-runs/

# Dogfood-run state. This repo is the PLUGIN, not an app project — a board here is
# experiment residue, not product. Real projects track these; this one must not.
docs/31-board-events.jsonl
docs/31-board.md
docs/team/context-manifest.json
docs/team/runs.jsonl

# Actor secrets. Plaintext HMAC keys — never commit them, and see the bound stated in
# scripts/lib/actor.mjs: while they live in the tree, an agent that can read them can mint
# a token for any role they grant.
docs/team/actors.json
