{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/block-shared-tree-destructive-git.sh\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/block-cross-worktree-write.sh\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/block-cross-worktree-write.sh\""
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/block-cross-worktree-write.sh\""
          }
        ]
      },
      {
        "matcher": "^(Task|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/require-spawn-contract.sh\""
          }
        ]
      },
      {
        "matcher": "^(Bash|Write|Edit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-gate-writes.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "(^|:)code-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/require-review-verdict.sh\""
          }
        ]
      },
      {
        "matcher": "(^|:)(ios-developer|android-developer|backend-developer|web-developer|monetization-engineer|devops-engineer|test-automation-engineer|ux-architect|product-designer|product-manager|product-researcher|qa-engineer|data-analyst|aso-specialist)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/persist-ic-report.sh\""
          }
        ]
      }
    ]
  }
}
