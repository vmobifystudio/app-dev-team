#!/bin/sh
# A stub device: the driver's logic is real, the hierarchy is this fixture's dump.xml.
case "$*" in
  devices) printf 'List of devices attached\nemulator-5554\tdevice\n' ;;
  "shell pm list packages") echo "package:com.example.dates" ;;
  "shell wm density") echo "Physical density: 440" ;;
  "pull "*) cp "$FIXTURE/dump.xml" "$3" ;;
  "exec-out screencap -p") printf 'png' ;;
  *) : ;;
esac
